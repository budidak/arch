# Set Permissions on files:
# ~/.ssh/config 600
# private keys 600
# public keys 644
# ~/.ssh directory 700

# Github.com
Host github.com
   HostName github.com
   User budidak
   IdentityFile ~/.ssh/git
   IdentitiesOnly yes
   PreferredAuthentications publickey
   AddKeysToAgent yes
   StrictHostKeyChecking ask

# Gitlab.com
Host gitlab.com
   HostName gitlab.com
   User budidak
   IdentityFile ~/.ssh/git
   IdentitiesOnly yes
   PreferredAuthentications publickey
   AddKeysToAgent yes
   StrictHostKeyChecking ask


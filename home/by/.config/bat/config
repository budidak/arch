#
# BAT CONFIGURATION FILE
# ~/.config/bat/config
#
# Run `bat --help` to get a list of all possible configuration options.
#
# NOTE: Do not forget to run `bat cache --build`

# Set notation for non-printable characters (unicode, caret).
# --nonprintable-notation=<notation>

# How to treat binary content (no-printing, as-text).
# --binary=<notation>

# Explicitly set the language for syntax highlighting.
# Use '--list-languages' to show all supported language names and file extensions.
# --language=<language>

# Set the tab width to T spaces.
--tabs=3

# Specify the text-wrapping mode (*auto*, never, character).
--wrap=auto

# Specify when to use ANSI sequences for italic text in the output (always, *never*).
--italic-text=always

# Alias for '--decorations=always --color=always'.
--force-colorization

# Specify when to use the pager (*auto*, never, always).
--paging=auto

# Determine which pager is used.
--pager="less --RAW-CONTROL-CHARS --quit-if-one-screen --mouse"

# Syntax mappings: map a certain filename pattern to a language.
#   Example 1: use the C++ syntax for Arduino .ino files
#   Example 2: Use ".gitignore"-style highlighting for ".ignore" files
#--map-syntax "*.ino:C++"
#--map-syntax ".ignore:Git Ignore"

# Ignore extension
# --ignored-suffix:<ignored-suffix>

# Set the theme for syntax highlighting.
--theme="Catppuccin Macchiato"

# Squeeze consecutive empty lines into a single empty line.
--squeeze-blank

# Specify when to strip ANSI escape sequences from the input (auto, always, *never*)
--strip-ansi=never

# Configure which elements to display in addition to the file contents.
# (default,full,auto,plain,changes,header,header-filename,grid,rule,numbers,snip)
--style=full
